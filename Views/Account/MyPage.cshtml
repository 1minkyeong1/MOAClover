@model MOAClover.Models.ViewModels.MyPageViewModel
@{
    ViewData["Title"] = "마이페이지";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/MyPage.css" asp-append-version="true" />

<div class="mypage-wrap">
    <div class="mypage-card">

        <div class="mypage-head">
            <h3>마이페이지</h3>
            <p>회원정보와 배송지를 관리할 수 있습니다.</p>
        </div>

        @if (TempData["Msg"] != null)
        {
            <div class="mypage-alert success">
                @TempData["Msg"]
            </div>
        }

        @if (TempData["Err"] != null)
        {
            <div class="mypage-alert error">
                @TempData["Err"]
            </div>
        }

        <!-- 기본정보 수정 -->
        <section class="mypage-section">
            <div class="mypage-section-title">
                <h5>기본정보</h5>
            </div>

            <form asp-controller="Account" asp-action="UpdateMyPage" method="post">
                @Html.AntiForgeryToken()

                <div class="mypage-form-grid">
                    <div>
                        <label>아이디</label>
                        <input class="form-control" value="@Model.UserName" readonly />
                    </div>

                    <div>
                        <label>이름</label>
                        <input class="form-control" name="Name" value="@Model.Name" />
                    </div>

                    <div>
                        <label>생년월일</label>
                        <input type="date"
                               class="form-control"
                               name="BirthDate"
                               value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div>
                        <label>전화번호</label>
                        <input class="form-control" name="Phone" value="@Model.Phone" />
                    </div>

                    <div class="full">
                        <label>이메일</label>
                        <input class="form-control" name="Email" value="@Model.Email" />
                    </div>
                </div>

                <button class="mypage-primary-btn" type="submit">
                    회원정보 저장
                </button>
            </form>
        </section>

        <!-- 배송지 목록 -->
        <section class="mypage-section">
            <div class="mypage-section-title">
                <h5>배송지</h5>
                <span>자주 사용하는 배송지를 저장해두세요.</span>
            </div>

            @if (Model.Addresses.Count == 0)
            {
                <div class="address-empty">
                    등록된 배송지가 없습니다.
                </div>
            }
            else
            {
                <div class="address-list">
                    @foreach (var a in Model.Addresses)
                    {
                        <article class="address-card @(a.IsDefault ? "is-default" : "")">
                            <div class="address-content">
                                <div class="address-main">
                                    <div class="address-person">
                                        <strong>@a.ReceiverName</strong>
                                        <span>@a.ReceiverPhone</span>

                                        @if (a.IsDefault)
                                        {
                                            <em>대표</em>
                                        }
                                    </div>

                                    <div class="address-text">
                                        (@a.ZipCode) @a.Address
                                        @if (!string.IsNullOrWhiteSpace(a.AddressDetail))
                                        {
                                            <span> @a.AddressDetail</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="address-actions">
                                @if (!a.IsDefault)
                                {
                                    <form asp-controller="Account" asp-action="SetDefaultAddress" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button class="address-btn default" type="submit">
                                            대표로
                                        </button>
                                    </form>
                                }

                                <button class="address-btn edit"
                                        type="button"
                                        data-id="@a.Id"
                                        data-name="@a.ReceiverName"
                                        data-phone="@a.ReceiverPhone"
                                        data-zip="@a.ZipCode"
                                        data-address="@a.Address"
                                        data-detail="@a.AddressDetail"
                                        data-default="@a.IsDefault.ToString().ToLower()"
                                        onclick="fillEditFromButton(this)">
                                    수정
                                </button>

                                <form asp-controller="Account"
                                      asp-action="DeleteAddress"
                                      method="post"
                                      onsubmit="return confirm('배송지를 삭제할까요?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button class="address-btn delete" type="submit">
                                        삭제
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }

            <!-- 배송지 추가/수정 폼 -->
            <div class="address-form-box">
                <div class="address-form-head">
                    <h6 id="addrTitle">배송지 추가</h6>
                    <button type="button" class="address-reset-link" onclick="resetAddr()">
                        입력 초기화
                    </button>
                </div>

                <form id="addrForm" asp-controller="Account" asp-action="AddAddress" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="addrId" value="0" />

                    <div class="mypage-form-grid">
                        <div>
                            <label>받는 사람</label>
                            <input class="form-control"
                                   name="ReceiverName"
                                   id="receiverName"
                                   value="@Model.Name" />
                        </div>

                        <div>
                            <label>연락처</label>
                            <input class="form-control"
                                   name="ReceiverPhone"
                                   id="receiverPhone"
                                   value="@Model.Phone" />
                        </div>

                        <div>
                            <label>우편번호</label>
                            <input class="form-control" name="ZipCode" id="zip" readonly />
                        </div>

                        <div class="full">
                            <label>주소</label>
                            <div class="address-search-row">
                                <input class="form-control" name="Address" id="addr" readonly />
                                <button class="address-search-btn" type="button" onclick="execDaumPostcode()">
                                    주소검색
                                </button>
                            </div>
                        </div>

                        <div class="full">
                            <label>상세주소</label>
                            <input class="form-control" name="AddressDetail" id="detail" />
                        </div>

                        <div class="full">
                            <label class="mypage-check">
                                <input type="checkbox" name="IsDefault" id="isDefault" value="true" />
                                <input type="hidden" name="IsDefault" value="false" />
                                대표 배송지로 지정
                            </label>
                        </div>
                    </div>

                    <div class="address-form-actions">
                        <button class="mypage-dark-btn" type="submit" id="addrSubmit">
                            저장
                        </button>
                        <button class="mypage-sub-btn" type="button" onclick="resetAddr()">
                            취소
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- 계정 관리 -->
        <section class="mypage-section account-section">
            <div class="mypage-section-title">
                <h5>계정 관리</h5>
                <span>비밀번호 변경과 회원 탈퇴는 필요할 때만 열어서 진행합니다.</span>
            </div>

            <div class="account-accordion">

                <!-- 비밀번호 변경 -->
                <div class="account-accordion-item">
                    <button type="button"
                            class="account-accordion-toggle"
                            onclick="toggleMyPagePanel('passwordPanel', this)">
                        <span>비밀번호 변경</span>
                        <em>⌄</em>
                    </button>

                    <div class="account-accordion-panel" id="passwordPanel">
                        <form asp-controller="Account" asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mypage-form-stack">
                                <input type="password"
                                       class="form-control"
                                       name="CurrentPassword"
                                       placeholder="현재 비밀번호"
                                       required />

                                <input type="password"
                                       class="form-control"
                                       name="NewPassword"
                                       placeholder="새 비밀번호(6자 이상)"
                                       required />

                                <input type="password"
                                       class="form-control"
                                       name="ConfirmNewPassword"
                                       placeholder="새 비밀번호 확인"
                                       required />
                            </div>

                            <button class="mypage-dark-btn full" type="submit">
                                비밀번호 변경
                            </button>
                        </form>
                    </div>
                </div>

                <!-- 회원 탈퇴 -->
                @if (!User.IsInRole("admin"))
                {
                    <div class="account-accordion-item danger">
                        <button type="button"
                                class="account-accordion-toggle danger"
                                onclick="toggleMyPagePanel('deletePanel', this)">
                            <span>회원 탈퇴</span>
                            <em>⌄</em>
                        </button>

                        <div class="account-accordion-panel" id="deletePanel">
                            <div class="delete-warning">
                                탈퇴 후 계정 복구가 어렵습니다. 주문내역 확인이 필요한 경우 탈퇴 전 반드시 확인해주세요.
                            </div>

                            <form asp-controller="Account"
                                  asp-action="DeleteAccount"
                                  method="post"
                                  onsubmit="return confirm('정말 탈퇴하시겠습니까? 탈퇴 후 복구 불가합니다.');">
                                @Html.AntiForgeryToken()

                                <input type="password"
                                       class="form-control"
                                       name="password"
                                       placeholder="비밀번호 확인"
                                       required />

                                <button class="mypage-danger-btn" type="submit">
                                    탈퇴하기
                                </button>
                            </form>
                        </div>
                    </div>
                }

            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="//t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>

    <script>
        function execDaumPostcode() {
            new daum.Postcode({
                oncomplete: function (data) {
                    let addr = data.userSelectedType === "R"
                        ? data.roadAddress
                        : data.jibunAddress;

                    let extra = "";

                    if (data.userSelectedType === "R") {
                        if (data.bname && /[동|로|가]$/g.test(data.bname)) {
                            extra += data.bname;
                        }

                        if (data.buildingName && data.apartment === "Y") {
                            extra += extra
                                ? ", " + data.buildingName
                                : data.buildingName;
                        }

                        if (extra) {
                            addr += " (" + extra + ")";
                        }
                    }

                    document.getElementById("zip").value = data.zonecode;
                    document.getElementById("addr").value = addr;
                    document.getElementById("detail").value = "";
                    document.getElementById("detail").focus();
                }
            }).open();
        }

        function fillEditFromButton(button) {
            fillEdit(
                button.dataset.id,
                button.dataset.name || "",
                button.dataset.phone || "",
                button.dataset.zip,
                button.dataset.address,
                button.dataset.detail || "",
                button.dataset.default
            );
        }

        function fillEdit(id, name, phone, zip, addr, detail, isDefault) {
            document.getElementById("addrTitle").innerText = "배송지 수정";

            const form = document.getElementById("addrForm");
            form.action = "/Account/UpdateAddress";

            document.getElementById("addrId").value = id;
            document.getElementById("receiverName").value = name;
            document.getElementById("receiverPhone").value = phone;
            document.getElementById("zip").value = zip;
            document.getElementById("addr").value = addr;
            document.getElementById("detail").value = detail || "";
            document.getElementById("isDefault").checked = isDefault === "true";

            updateDefaultPreview();

            document.getElementById("addrSubmit").innerText = "수정 저장";

            document.querySelector(".address-form-box")
                ?.scrollIntoView({ behavior: "smooth", block: "center" });
        }

        function resetAddr() {
            document.getElementById("addrTitle").innerText = "배송지 추가";

            const form = document.getElementById("addrForm");
            form.action = "/Account/AddAddress";

            document.getElementById("addrId").value = 0;
            document.getElementById("receiverName").value = "";
            document.getElementById("receiverPhone").value = "";
            document.getElementById("zip").value = "";
            document.getElementById("addr").value = "";
            document.getElementById("detail").value = "";
            document.getElementById("isDefault").checked = false;

            updateDefaultPreview();

            document.getElementById("addrSubmit").innerText = "저장";
        }

        function toggleMyPagePanel(panelId, button) {
            const panel = document.getElementById(panelId);

            if (!panel) {
                return;
            }

            const isOpen = panel.classList.contains("open");

            document.querySelectorAll(".account-accordion-panel")
                .forEach(x => x.classList.remove("open"));

            document.querySelectorAll(".account-accordion-toggle")
                .forEach(x => x.classList.remove("open"));

            if (!isOpen) {
                panel.classList.add("open");
                button.classList.add("open");
            }
        }

        document.getElementById("isDefault")?.addEventListener("change", updateDefaultPreview);

        function updateDefaultPreview() {
            const checked = document.getElementById("isDefault")?.checked;
            const title = document.getElementById("addrTitle");

            if (!title) {
                return;
            }

            const oldBadge = document.getElementById("addrDefaultPreviewBadge");

            if (oldBadge) {
                oldBadge.remove();
            }

            if (checked) {
                const badge = document.createElement("span");
                badge.id = "addrDefaultPreviewBadge";
                badge.className = "address-preview-badge";
                badge.innerText = "대표 예정";
                title.appendChild(badge);
            }
        }

    </script>
}
