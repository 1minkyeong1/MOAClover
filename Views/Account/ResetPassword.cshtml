@{
    ViewData["Title"] = "비밀번호 재설정";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/Find.css" />

<div class="find-container">

    <h2>새 비밀번호 설정</h2>

    <form method="post"
          asp-action="ResetPassword"
          asp-controller="Account">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="tokenId"
               value="@ViewBag.TokenId" />

        <input type="hidden"
               name="token"
               value="@ViewBag.Token" />

        <!-- 새 비밀번호 -->

        <label>새 비밀번호</label>

        <input type="password"
               id="newPassword"
               name="newPassword"
               autocomplete="new-password"
               required />

        <!-- 비밀번호 규칙 -->

        <div class="password-rules">

            <div id="rule-length" class="invalid">
                ❌ 8자 이상
            </div>

            <div id="rule-upper" class="invalid">
                ❌ 영문 대문자 포함
            </div>

            <div id="rule-lower" class="invalid">
                ❌ 영문 소문자 포함
            </div>

            <div id="rule-digit" class="invalid">
                ❌ 숫자 포함
            </div>

        </div>

        <!-- 비밀번호 확인 -->

        <label>비밀번호 확인</label>

        <input type="password"
               id="confirmPassword"
               name="confirmPassword"
               autocomplete="new-password"
               required />

        <!-- 일치 여부 -->

        <div id="match-message" class="invalid">
            ❌ 비밀번호가 일치하지 않습니다
        </div>

        <!-- 버튼 -->

        <button class="btn-main"
                id="submitBtn"
                type="submit"
                disabled>
            비밀번호 변경
        </button>

        <button type="button"
                class="btn-main btn-back"
                onclick="location.href='/Account/Login'">

            로그인으로 이동

        </button>

    </form>

    <!-- 서버 에러 -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="server-error">

            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }

        </div>
    }

</div>

<script>
    const pw = document.getElementById("newPassword");
    const confirmPw = document.getElementById("confirmPassword");
    const submitBtn = document.getElementById("submitBtn");

    const rules = {
        length: {
            id: "rule-length",
            text: "8자 이상",
            test: value => value.length >= 8
        },
        upper: {
            id: "rule-upper",
            text: "영문 대문자 포함",
            test: value => /[A-Z]/.test(value)
        },
        lower: {
            id: "rule-lower",
            text: "영문 소문자 포함",
            test: value => /[a-z]/.test(value)
        },
        digit: {
            id: "rule-digit",
            text: "숫자 포함",
            test: value => /\d/.test(value)
        }
    };

    pw.addEventListener("input", validatePassword);
    confirmPw.addEventListener("input", validatePassword);

    validatePassword();

    function validatePassword() {
        const value = pw.value;
        const confirmValue = confirmPw.value;

        let allRulesValid = true;

        Object.values(rules).forEach(rule => {
            const isValid = rule.test(value);
            updateRule(rule.id, rule.text, isValid);

            if (!isValid) {
                allRulesValid = false;
            }
        });

        const isMatch =
            value.length > 0 &&
            confirmValue.length > 0 &&
            value === confirmValue;

        updateMatchMessage(confirmValue, isMatch);

        submitBtn.disabled = !(allRulesValid && isMatch);
    }

    function updateRule(id, text, isValid) {
        const el = document.getElementById(id);

        el.className = isValid ? "valid" : "invalid";
        el.textContent = `${isValid ? "✔" : "❌"} ${text}`;
    }

    function updateMatchMessage(confirmValue, isMatch) {
        const matchMessage = document.getElementById("match-message");

        if (confirmValue.length === 0) {
            matchMessage.className = "invalid";
            matchMessage.textContent = "❌ 비밀번호를 다시 입력해주세요";
            return;
        }

        if (isMatch) {
            matchMessage.className = "valid";
            matchMessage.textContent = "✔ 비밀번호가 일치합니다";
        } else {
            matchMessage.className = "invalid";
            matchMessage.textContent = "❌ 비밀번호가 일치하지 않습니다";
        }
    }
</script>