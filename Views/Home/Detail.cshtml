@model MOAClover.Models.ViewModels.ProductDetailViewModel

@{
    ViewData["Title"] = "상품페이지";
}

<link rel="stylesheet" href="~/css/Detail.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/QnA.css" asp-append-version="true" />

<div class="detail-wrap">

    <!-- 상단 -->
    <div class="detail-top">

        <!-- 왼쪽 이미지 -->
        <div class="detail-left">
            <img src="@Model.MainImageUrl" class="main-img" alt="@Model.Name" />

            <div class="thumbnail-wrap">
                @foreach (var img in Model.ImageUrls)
                {
                    <img src="@img" class="thumb" onclick="changeImage(this.src)" alt="@Model.Name" />
                }
            </div>
        </div>

        <!-- 오른쪽 상품정보 -->
        <div class="detail-right">
            <div class="category-info">
                <span>@Model.CategoryPath</span>
            </div>

            <h1>@Model.Name</h1>

            <!-- 배송비 정보 -->
            @{
                string shippingText;

                if (Model.ShippingType == "Included")
                {
                    shippingText = "배송비 포함";
                }
                else if (Model.ShippingType == "Free")
                {
                    shippingText = "무료배송";
                }
                else if (Model.ShippingType == "ConditionalFree")
                {
                    if (Model.FreeShippingMinAmount.HasValue && Model.FreeShippingMinAmount.Value > 0)
                    {
                        shippingText = $"{Model.FreeShippingMinAmount.Value:N0}원 이상 무료배송";
                    }
                    else
                    {
                        shippingText = $"{Model.ShippingFee:N0}원";
                    }
                }
                else if (Model.ShippingType == "Collect")
                {
                    shippingText = "착불/별도";
                }
                else
                {
                    shippingText = $"{Model.ShippingFee:N0}원";
                }
            }

            <!-- 가격 -->
            <div class="detail-price">
                @if (Model.DiscountRate.HasValue && Model.DiscountRate.Value > 0)
                {
                    <div class="detail-price-row">
                        <div class="rate-big">@Model.DiscountRate%</div>

                        <div class="price-right">
                            <div class="price-line">
                                <span class="origin">@Model.Price.ToString("N0")원</span>
                                <span class="sale">@Model.FinalPrice.ToString("N0")원</span>
                            </div>

                            <div class="ship-line">
                                <span class="ship-icon">🚚</span>
                                <span class="ship-text">@shippingText</span>
                            </div>

                            @if (Model.JejuExtraFee > 0 || Model.RemoteAreaExtraFee > 0)
                            {
                                <div class="ship-extra-line">
                                    제주/도서산간 추가배송비가 있을 수 있습니다.
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="detail-price-row">
                        <div class="price-right">
                            <div class="price-line">
                                <span class="sale">@Model.Price.ToString("N0")원</span>
                            </div>

                            <div class="ship-line">
                                <span class="ship-icon">🚚</span>
                                <span class="ship-text">@shippingText</span>
                            </div>

                            @if (Model.JejuExtraFee > 0 || Model.RemoteAreaExtraFee > 0)
                            {
                                <div class="ship-extra-line">
                                    제주/도서산간 추가배송비가 있을 수 있습니다.
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.UseStock)
                {
                    if (Model.StockQuantity > 0)
                    {
                        <div class="detail-stock-line">
                            <span class="stock-ok">재고 @Model.StockQuantity 개</span>
                        </div>
                    }
                    else
                    {
                        <div class="detail-stock-line">
                            <span class="stock-soldout">품절</span>
                        </div>
                    }
                }
                else
                {
                    <div class="detail-stock-line">
                        <span class="stock-free">재고 여유</span>
                    </div>
                }
            </div>

            <!-- 구매 영역 -->
            <div class="detail-purchase-area">

                <div class="detail-buy-actions">
                    @if (Model.UseStock && Model.StockQuantity <= 0)
                    {
                        <div class="detail-soldout-box">
                            <div class="detail-soldout-title">품절된 상품입니다.</div>
                            <div class="detail-soldout-desc">
                                현재 이 상품은 구매할 수 없습니다.
                            </div>

                            <div class="detail-soldout-actions">
                                <button type="button" class="detail-cart-btn disabled" disabled>
                                    장바구니 담기
                                </button>

                                <button type="button" class="detail-buy-btn disabled" disabled>
                                    바로 구매하기
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Cart"
                              asp-action="Add"
                              method="post"
                              class="detail-cart-form">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <input type="hidden"
                                   name="returnUrl"
                                   value="@Url.Action("Detail", "Home", new { id = Model.ProductId })" />

                            <div class="detail-buy-inner">
                                <div class="detail-qty-row">
                                    <label>수량</label>

                                    <input type="number"
                                           name="quantity"
                                           value="1"
                                           min="1"
                                           max="@(Model.UseStock? Model.StockQuantity: 999)" />
                                </div>

                                @if (Model.UseStock && Model.StockQuantity > 0)
                                {
                                    <div class="detail-stock-help">
                                        최대 @Model.StockQuantity 개까지 구매할 수 있습니다.
                                    </div>
                                }

                                <button type="submit" class="detail-cart-btn">
                                    장바구니 담기
                                </button>

                                <button type="submit"
                                        name="directBuy"
                                        value="true"
                                        class="detail-buy-btn">
                                    바로 구매하기
                                </button>
                            </div>
                        </form>
                    }
                </div>

                <div class="external-links">
                    @if (!string.IsNullOrWhiteSpace(Model.SmartStoreUrl))
                    {
                        <a href="@Model.SmartStoreUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="external-link smartstore-link">
                            스마트스토어에서 구매하기
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CoupangUrl))
                    {
                        <a href="@Model.CoupangUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="external-link coupang-link">
                            쿠팡에서 구매하기
                        </a>
                    }

                    @if (string.IsNullOrWhiteSpace(Model.SmartStoreUrl)
                                        && string.IsNullOrWhiteSpace(Model.CoupangUrl))
                    {
                        <div class="external-link-empty">
                            연결된 외부 판매처가 없습니다.
                        </div>
                    }
                </div>

            </div>

            <!-- 수정, 삭제 버튼 -->
            @if (User.IsInRole("admin"))
            {
                <div class="detail-admin-actions">
                    <a class="btn btn-outline-primary"
                       asp-controller="Home"
                       asp-action="Edit"
                       asp-route-id="@Model.ProductId">
                        수정
                    </a>

                    <a class="btn btn-outline-danger"
                       asp-controller="Home"
                       asp-action="Delete"
                       asp-route-id="@Model.ProductId">
                        삭제
                    </a>
                </div>
            }

        </div>
    </div>

    <!-- 탭 -->
    <div class="tab-menu">
        <div class="tab active" onclick="openTab(this,'detail')">상세정보</div>
        <div class="tab" onclick="openTab(this,'qa')">Q&A</div>
        <div class="tab" onclick="openTab(this,'return')">반품/교환</div>
    </div>

    <!-- 탭 내용 -->
    <div class="tab-content">

        <!-- 상세정보 -->
        <div id="detail" class="tab-panel active detail-html">

            @if (Model.DetailImageUrls.Any())
            {
                foreach (var img in Model.DetailImageUrls)
                {
                    <img src="@img" alt="@Model.Name" />
                }
            }

            @if (Model.VideoUrls.Any())
            {
                foreach (var video in Model.VideoUrls)
                {
                    <video src="@video" controls></video>
                }
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="text-desc">
                    @Html.Raw(Model.Description)
                </div>
            }

            <div class="policy-block">
                <img src="~/images/PrivacyProvide.jpg" class="policy-img" alt="개인정보 제공 안내" />
            </div>

        </div>

        <!-- Q&A 탭 -->
        <div id="qa" class="tab-panel">
            <div id="qnaArea" class="qna-scroll-anchor"></div>

            <div id="qna-root" data-product-id="@Model.ProductId">

                <div class="qna-toolbar">
                    <button type="button" id="btnShowQnaForm">문의등록</button>
                </div>

                <div id="qna-form-area" class="hidden">
                    @await Html.PartialAsync("~/Views/Home/QnAForm.cshtml", Model)
                </div>

                <div id="qna-list-area">
                    @await Html.PartialAsync("~/Views/Home/QnA.cshtml", Model)
                </div>

            </div>
        </div>

        <!-- 반품/교환 -->
        <div id="return" class="tab-panel return-policy">
            <img src="/images/ReturnExchange.jpg" class="return-img" alt="반품/교환 안내" />
        </div>

    </div>
</div>

@if ((TempData["CartAdded"] as string) == "true")
{
    <div class="cart-added-modal" id="cartAddedModal">
        <div class="cart-added-box">
            <div class="cart-added-icon">✓</div>

            <h3>장바구니가 업데이트되었습니다.</h3>

            <p>
                @(TempData["CartMessage"] ?? "장바구니에 상품을 담았습니다.")<br />
                장바구니로 이동하시겠습니까?
            </p>

            <div class="cart-added-actions">
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="cart-added-go">
                    장바구니로 이동
                </a>

                <button type="button"
                        class="cart-added-stay"
                        onclick="closeCartAddedModal()">
                    계속 쇼핑하기
                </button>
            </div>
        </div>
    </div>
}

<script>
    function changeImage(src) {
        const mainImage = document.querySelector(".main-img");

        if (mainImage) {
            mainImage.src = src;
        }
    }

    function openTab(el, id) {
        document.querySelectorAll(".tab")
            .forEach(t => t.classList.remove("active"));

        document.querySelectorAll(".tab-panel")
            .forEach(p => p.classList.remove("active"));

        el.classList.add("active");

        const panel = document.getElementById(id);

        if (panel) {
            panel.classList.add("active");
        }
    }

    function closeCartAddedModal() {
        const modal = document.getElementById("cartAddedModal");

        if (modal) {
            modal.style.display = "none";
        }
    }

    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            closeCartAddedModal();
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        if (window.location.hash === "#qnaArea") {
            const tabs = document.querySelectorAll(".tab");
            let qnaTab = null;

            tabs.forEach(function (tab) {
                const onclickValue = tab.getAttribute("onclick") || "";

                if (onclickValue.includes("'qa'") || onclickValue.includes('"qa"')) {
                    qnaTab = tab;
                }
            });

            if (qnaTab) {
                openTab(qnaTab, "qa");
            }

            setTimeout(function () {
                const qnaArea = document.getElementById("qnaArea");

                if (qnaArea) {
                    qnaArea.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            }, 250);
        }
    });
</script>

@section Scripts {
    <script src="~/js/qna.js" asp-append-version="true"></script>
}
