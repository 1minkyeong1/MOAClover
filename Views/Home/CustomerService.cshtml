@using Microsoft.EntityFrameworkCore
@inject MOAClover.Data.ApplicationDbContext Db

@{
    ViewData["Title"] = "고객센터";
    Layout = "_Layout";

    var setting = await Db.SiteSettings
        .AsNoTracking()
        .OrderBy(x => x.SiteSettingId)
        .FirstOrDefaultAsync();

    var shopName = string.IsNullOrWhiteSpace(setting?.ShopName)
        ? "모아클로버"
        : setting!.ShopName;

    var customerPhone = string.IsNullOrWhiteSpace(setting?.CustomerPhone)
        ? "-"
        : setting!.CustomerPhone;

    var customerEmail = string.IsNullOrWhiteSpace(setting?.CustomerEmail)
        ? "-"
        : setting!.CustomerEmail;

    var customerServiceHours = string.IsNullOrWhiteSpace(setting?.CustomerServiceHours)
        ? "-"
        : setting!.CustomerServiceHours;

    var policyStyleParts = new List<string>();

    if (!string.IsNullOrWhiteSpace(setting?.PolicyPageBackgroundColor))
    {
        policyStyleParts.Add($"background-color:{setting.PolicyPageBackgroundColor}");
    }

    if (setting?.UsePolicyPageBackgroundImage == true
        && !string.IsNullOrWhiteSpace(setting.PolicyPageBackgroundImageUrl))
    {
        policyStyleParts.Add($"background-image:url('{setting.PolicyPageBackgroundImageUrl}')");
        policyStyleParts.Add("background-size:cover");
        policyStyleParts.Add("background-position:center top");
        policyStyleParts.Add("background-repeat:no-repeat");
    }

    if (!string.IsNullOrWhiteSpace(setting?.PolicyPageTextColor))
    {
        policyStyleParts.Add($"--policy-text-color:{setting.PolicyPageTextColor}");
    }

    if (!string.IsNullOrWhiteSpace(setting?.PolicyPageBoxBackgroundColor))
    {
        policyStyleParts.Add($"--policy-box-bg-color:{setting.PolicyPageBoxBackgroundColor}");
    }

    var policyStyle = string.Join(";", policyStyleParts);
}

<link rel="stylesheet" href="~/css/Policy.css" asp-append-version="true" />

<div class="policy-wrap" style="@policyStyle">
    <div class="policy-head">
        <h2>고객센터</h2>
        <p>@shopName 이용 중 궁금한 점이 있으시면 아래 안내를 확인해주세요.</p>
    </div>

    <section class="policy-section">
        <h3>고객센터 안내</h3>

        <p>
            <strong>전화번호:</strong> @customerPhone
        </p>

        <p>
            <strong>이메일:</strong> @customerEmail
        </p>

        <p>
            <strong>운영시간:</strong> @customerServiceHours
        </p>

        <p>
            문의 내용 확인 후 순차적으로 답변드립니다.
            주문, 배송, 취소, 환불, 반품, 교환 문의는 주문번호를 함께 알려주시면 더 빠르게 확인할 수 있습니다.
        </p>
    </section>

    <section class="policy-section">
        <h3>주문 관련 문의</h3>
        <p>
            회원은 로그인 후 <strong>주문내역</strong>에서 주문 상태를 확인할 수 있습니다.
            비회원은 <strong>비회원 주문조회</strong>에서 주문번호와 주문조회 비밀번호로 확인할 수 있습니다.
        </p>
    </section>

    <section class="policy-section">
        <h3>취소/환불 문의</h3>
        <p>
            결제 전 주문은 주문상세에서 직접 취소할 수 있습니다.
            결제 완료 후에는 취소/환불 요청으로 접수되며, 관리자 확인 후 처리됩니다.
        </p>
    </section>

    <section class="policy-section">
        <h3>반품/교환 문의</h3>
        <p>
            배송중 또는 배송완료 주문은 주문상세에서 반품/교환 요청을 접수할 수 있습니다.
            상품 회수 및 상태 확인 후 처리 결과를 안내드립니다.
        </p>
    </section>

    <section class="policy-section">
        <h3>상품 문의</h3>
        <p>
            상품별 문의는 상품상세 페이지의 Q&A 영역을 이용해주세요.
            비밀글로 문의하면 관리자와 작성자만 내용을 확인할 수 있습니다.
        </p>
    </section>
</div>