@model MOAClover.Models.ViewModels.ProductDetailViewModel

@{
    int currentPage = ViewBag.QnACurrentPage ?? 1;
    int totalPages = ViewBag.QnATotalPages ?? 1;

    bool isAdmin = User.IsInRole("admin");
    string? me = User.Identity?.Name;
}

<div class="qna-board-box">

    <div class="qna-board-head">
        <div>
            <h4>상품 문의</h4>
            <p>상품에 대해 궁금한 점을 확인할 수 있습니다.</p>
        </div>

        <span class="qna-count">@((Model.QnAs?.Count ?? 0))건</span>
    </div>

    @if (Model.QnAs == null || !Model.QnAs.Any())
    {
        <div class="qna-empty-board">
            아직 등록된 상품 문의가 없습니다.
        </div>
    }
    else
    {
        <div class="qna-board-list">
            @foreach (var q in Model.QnAs)
            {
                bool isOwner = (!string.IsNullOrEmpty(me) && me == q.UserName);
                bool canSee = !q.IsSecret || isAdmin || isOwner;
                bool hasAnswer = !string.IsNullOrWhiteSpace(q.Answer);

                <article class="qna-board-row @(hasAnswer ? "answered" : "waiting")" data-qna-id="@q.QnAId">

                    <div class="qna-board-row-top">
                        <div class="qna-board-meta">
                            <strong>@q.UserName</strong>
                            <span>@q.CreatedAt.ToString("yyyy-MM-dd")</span>

                            @if (q.IsSecret)
                            {
                                <em class="qna-badge secret">비밀글</em>
                            }

                            <em class="qna-badge @(hasAnswer ? "done" : "wait")">
                                @(hasAnswer ? "답변완료" : "답변대기")
                            </em>
                        </div>

                        @if (isAdmin || isOwner)
                        {
                            <div class="qna-board-actions">
                                <button type="button" onclick="startEditQnA(@q.QnAId)">수정</button>
                                <button type="button" class="danger" onclick="deleteQnA(@q.QnAId)">삭제</button>
                            </div>
                        }
                    </div>

                    <div class="qna-board-question @(canSee ? "" : "is-secret")">
                        <span>Q.</span>

                        @if (!canSee)
                        {
                            <strong class="secret-text">🔒 비밀글입니다.</strong>
                        }
                        else
                        {
                            <strong>@((q.Question ?? "").Trim())</strong>
                        }
                    </div>

                    @if (canSee && (isAdmin || isOwner))
                    {
                        <div class="qna-edit-form hidden" id="edit_box_@q.QnAId">
                            <label>문의 수정</label>
                            <textarea id="edit_question_@q.QnAId">@q.Question</textarea>

                            <label class="secret-label">
                                <input type="checkbox" id="edit_secret_@q.QnAId" @(q.IsSecret ? "checked" : "") />
                                비밀글
                            </label>

                            <div class="qna-edit-actions">
                                <button type="button" onclick="saveEditQnA(@q.QnAId)">저장</button>
                                <button type="button" class="subtle" onclick="cancelEditQnA(@q.QnAId)">취소</button>
                            </div>
                        </div>
                    }

                    @if (canSee)
                    {
                        if (hasAnswer)
                        {
                            <div class="qna-board-answer">
                                <span>A.</span>

                                <div>
                                    <strong>@((q.Answer ?? "").Trim())</strong>

                                    @if (isAdmin)
                                    {
                                        <div class="qna-answer-actions">
                                            <button type="button" onclick="startEditAnswer(@q.QnAId)">답변 수정</button>
                                            <button type="button" class="danger" onclick="deleteAnswer(@q.QnAId)">답변 삭제</button>
                                        </div>

                                        <div class="qna-edit-answer-form hidden" id="edit_answer_box_@q.QnAId">
                                            <label>답변 수정</label>
                                            <textarea id="edit_answer_@q.QnAId">@q.Answer</textarea>

                                            <div class="qna-edit-actions">
                                                <button type="button" onclick="saveEditAnswer(@q.QnAId)">저장</button>
                                                <button type="button" class="subtle" onclick="cancelEditAnswer(@q.QnAId)">취소</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else if (isAdmin)
                        {
                            <div class="qna-answer-form">
                                <textarea id="answer_@q.QnAId" placeholder="답변을 입력하세요"></textarea>
                                <button type="button" onclick="answerQnA(@q.QnAId)">답변 등록</button>
                            </div>
                        }
                        else
                        {
                            <div class="qna-board-answer waiting-answer">
                                <span>A.</span>
                                <strong>답변 준비중입니다.</strong>
                            </div>
                        }
                    }

                </article>
            }
        </div>
    }

    @if (totalPages > 1)
    {
        var startPage = Math.Max(1, currentPage - 2);
        var endPage = Math.Min(totalPages, currentPage + 2);

        <div class="qna-pagination-wrap">
            <div class="qna-pagination-info">
                @currentPage / @totalPages 페이지
            </div>

            <div class="qna-pagination">
                @if (currentPage > 1)
                {
                    <a href="javascript:void(0)" onclick="loadQnAPage(1)" title="첫 페이지">«</a>
                    <a href="javascript:void(0)" onclick="loadQnAPage(@(currentPage - 1))" title="이전 페이지">‹</a>
                }

                @if (startPage > 1)
                {
                    <a href="javascript:void(0)" onclick="loadQnAPage(1)">1</a>

                    @if (startPage > 2)
                    {
                        <span class="pagination-ellipsis">...</span>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <a href="javascript:void(0)"
                       class="@(i == currentPage ? "active" : "")"
                       onclick="loadQnAPage(@i)">
                        @i
                    </a>
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <span class="pagination-ellipsis">...</span>
                    }

                    <a href="javascript:void(0)" onclick="loadQnAPage(@totalPages)">
                        @totalPages
                    </a>
                }

                @if (currentPage < totalPages)
                {
                    <a href="javascript:void(0)" onclick="loadQnAPage(@(currentPage + 1))" title="다음 페이지">›</a>
                    <a href="javascript:void(0)" onclick="loadQnAPage(@totalPages)" title="마지막 페이지">»</a>
                }
            </div>
        </div>
    }

</div>