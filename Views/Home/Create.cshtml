@model MOAClover.Models.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "상품 등록";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/create.css" asp-append-version="true" />

<div class="create-page-wrap">
    <div class="create-card">
        <h3 class="create-title">상품 등록</h3>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="create-error-box">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Home" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold">상품명</label>
                    <input class="form-control" asp-for="Name" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">노출</label>
                    <select class="form-select" asp-for="IsVisible">
                        <option value="true">노출</option>
                        <option value="false">숨김</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">정가</label>
                    <input class="form-control" asp-for="Price" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">할인율(%)</label>
                    <input class="form-control" asp-for="DiscountRate" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">재고 관리</label>

                    <div class="stock-check-box">
                        <input asp-for="UseStock"
                               class="form-check-input"
                               id="UseStock" />

                        <label class="form-check-label" for="UseStock">
                            재고 수량 관리하기
                        </label>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">재고 수량</label>
                    <input asp-for="StockQuantity"
                           class="form-control"
                           id="StockQuantity"
                           min="0" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">배송 방식</label>
                    <select class="form-select" asp-for="ShippingType">
                        <option value="Included">배송비 포함</option>
                        <option value="Free">무료배송</option>
                        <option value="Fixed">고정 배송비</option>
                        <option value="ConditionalFree">조건부 무료배송</option>
                        <option value="Collect">착불/별도</option>
                    </select>
                    <span asp-validation-for="ShippingType" class="text-danger"></span>
                </div>

                <div class="col-md-4 shipping-field shipping-fee-field">
                    <label class="form-label fw-bold">기본 배송비</label>
                    <input class="form-control" asp-for="ShippingFee" placeholder="예: 4000" />
                    <span asp-validation-for="ShippingFee" class="text-danger"></span>
                </div>

                <div class="col-md-4 shipping-field free-min-field">
                    <label class="form-label fw-bold">무료배송 기준금액</label>
                    <input class="form-control" asp-for="FreeShippingMinAmount" placeholder="예: 30000" />
                    <span asp-validation-for="FreeShippingMinAmount" class="text-danger"></span>
                </div>

                <div class="col-md-4 shipping-field extra-fee-field">
                    <label class="form-label fw-bold">제주 추가배송비</label>
                    <input class="form-control" asp-for="JejuExtraFee" placeholder="예: 3000" />
                    <span asp-validation-for="JejuExtraFee" class="text-danger"></span>
                </div>

                <div class="col-md-4 shipping-field extra-fee-field">
                    <label class="form-label fw-bold">도서산간 추가배송비</label>
                    <input class="form-control" asp-for="RemoteAreaExtraFee" placeholder="예: 5000" />
                    <span asp-validation-for="RemoteAreaExtraFee" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">스마트스토어 상품 URL</label>
                    <input class="form-control"
                           asp-for="SmartStoreUrl"
                           placeholder="https://smartstore.naver.com/moaclover/products/상품번호" />
                    <span asp-validation-for="SmartStoreUrl" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">쿠팡 상품 URL</label>
                    <input class="form-control"
                           asp-for="CoupangUrl"
                           placeholder="https://www.coupang.com/vp/products/상품번호" />
                    <span asp-validation-for="CoupangUrl" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-bold">상세설명(HTML 가능)</label>
                    <textarea class="form-control" asp-for="Description" rows="6"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            <!-- ✅ 카테고리 4단 선택 -->
            <h5 style="font-weight:900;">카테고리 선택</h5>

            <input type="hidden" asp-for="CategoryId" id="FinalCategoryId" />

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">대분류</label>
                    <select class="form-select" id="catLv1">
                        <option value="">선택</option>
                        @foreach (var c in (IEnumerable<dynamic>)ViewBag.Level1)
                        {
                            <option value="@c.CategoryId">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">중분류</label>
                    <select class="form-select" id="catLv2" disabled>
                        <option value="">선택</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">소분류</label>
                    <select class="form-select" id="catLv3" disabled>
                        <option value="">선택</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">세부</label>
                    <select class="form-select" id="catLv4" disabled>
                        <option value="">선택</option>
                    </select>
                </div>

                <div class="col-12 create-help-text">
                    가장 마지막으로 선택된 값이 저장됩니다. (세부가 없으면 소분류/중분류/대분류까지 가능)
                </div>
            </div>

            <hr class="my-4" />

            <!-- ✅ 미디어 업로드 -->
            <div class="product-media-box">
                <h5 class="product-media-title">미디어 업로드</h5>

                <!-- 상품 이미지 -->
                <div class="product-media-section">
                    <div class="product-media-head">
                        <div>
                            <strong>상품 이미지</strong>
                            <p>첫 번째 이미지가 대표 이미지로 사용됩니다. 최대 8장까지 등록 가능합니다.</p>
                        </div>
                        <span class="product-media-required">필수</span>
                    </div>

                    <input type="file"
                           class="form-control product-media-input"
                           asp-for="ThumbImages"
                           id="ThumbImages"
                           multiple
                           accept="image/*"
                           data-val="false"
                           data-media-kind="image"
                           data-preview-target="thumbPreview"
                           data-max-count="8" />

                    <div id="thumbPreview" class="product-media-grid"></div>
                </div>

                <!-- 상세페이지 이미지 -->
                <div class="product-media-section">
                    <div class="product-media-head">
                        <div>
                            <strong>상세페이지 이미지</strong>
                            <p>상세정보 탭에 표시됩니다. 없으면 비워둬도 됩니다.</p>
                        </div>
                        <span class="product-media-optional">선택</span>
                    </div>

                    <input type="file"
                           class="form-control product-media-input"
                           asp-for="DetailImages"
                           id="DetailImages"
                           multiple
                           accept="image/*"
                           data-val="false"
                           data-media-kind="image"
                           data-preview-target="detailPreview" />

                    <div id="detailPreview" class="product-media-grid"></div>
                </div>

                <!-- 동영상 -->
                <div class="product-media-section">
                    <div class="product-media-head">
                        <div>
                            <strong>동영상</strong>
                            <p>동영상이 있으면 등록하고, 없으면 비워둬도 됩니다.</p>
                        </div>
                        <span class="product-media-optional">선택</span>
                    </div>

                    <input type="file"
                           class="form-control product-media-input"
                           asp-for="Videos"
                           id="Videos"
                           multiple
                           accept="video/*"
                           data-val="false"
                           data-media-kind="video"
                           data-preview-target="videoPreview" />

                    <div id="videoPreview" class="product-media-grid"></div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary flex-grow-1 fw-bold">등록</button>
                <a class="btn btn-outline-secondary flex-shrink-0" style="min-width:160px;"
                   asp-controller="Home" asp-action="Index">
                    취소
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/category4level.js" asp-append-version="true"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/product-create.js" asp-append-version="true"></script>
}